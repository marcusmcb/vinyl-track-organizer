{
  "name": "@vinyl/catalog-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node-pg-migrate up"
  },
  "dependencies": {
    "@vinyl/shared-types": "workspace:*",
    "pg": "^8.13.0",
    "pg-copy-streams": "^6.0.6"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "node-pg-migrate": "^7.9.0",
    "typescript": "^5.6.0"
  }
}
